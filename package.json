{
  "name": "idfkit-shoebox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "idfkit-engine-assets public/energyplus && node scripts/copy-schemas.mjs && node scripts/stage-weather.mjs",
    "dev": "vite",
    "prebuild": "idfkit-engine-assets public/energyplus && node scripts/copy-schemas.mjs && node scripts/stage-weather.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "undeploy": "node scripts/deploy.mjs --remove"
  },
  "dependencies": {
    "@idfkit/core": "^0.1.0",
    "@idfkit/engine": "^0.1.0",
    "@idfkit/engine-assets": "26.1.0",
    "@idfkit/schemas": "^0.1.0",
    "@idfkit/weather": "^0.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "vite": "^7.0.0"
  }
}
